# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=recipient@example.com

# DNSE LightSpeed API (never commit real credentials)
DNSE_API_KEY=your_dnse_api_key_here
DNSE_API_SECRET=your_dnse_api_secret_here
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_API_VERSION=2026-05-07

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Set to true to enable test mode (won't send messages)
TEST_MODE=false
